# 飞书开放平台应用凭证（企业自建应用）

# 获取方式：飞书开放平台 -> 创建企业自建应用 -> 凭证与基础信息

FEISHU_APP_ID=cli_xxxxxxxx

FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx



# 可选：API 域名，国内默认 open.feishu.cn，海外 Lark 使用 open.larksuite.com

# FEISHU_BASE_URL=https://open.feishu.cn



# 生产环境推荐：单进程同时跑定时推送 + @机器人（python main.py serve）

# 仅长连接：python main.py ws

# 启动时自动爬虫写库（默认开启）；每 N 小时后台再刷新一次

# WS_REFRESH_ON_START=1

# WS_REFRESH_INTERVAL_HOURS=24

# 同一 message_id 去重保留天数；超过 N 小时的旧 @ 重放时不回复

# WS_MESSAGE_DEDUP_DAYS=7

# WS_MESSAGE_MAX_AGE_HOURS=3

# @机器人 多轮分析 session 有效期（秒），默认 2 小时
# BOT_SESSION_TTL_SECONDS=7200



# 内网 Workflow API（Dify Workflow，应用必须先发布）

# WORKFLOW_API_URL=http://10.0.62.178:3100/v1/workflows/run

# WORKFLOW_API_KEY=app-xxxxxxxx

# WORKFLOW_USER=feishu-bot

# WORKFLOW_TIMEOUT=90
# 超时后是否重试一次（默认 0：直接降级本地回复，避免群聊卡住 6 分钟）
# WORKFLOW_TIMEOUT_RETRY=0
# WORKFLOW_MAX_EVENTS=6
# WORKFLOW_DESC_MAX_CHARS=200

#

# 开始节点输入变量名（必须是「段落/长文本」，不能是 48 字以内的短文本）

# WORKFLOW_INPUT_QUERY=query

# WORKFLOW_INPUT_EVENTS=events_json

# WORKFLOW_INPUT_META=search_meta_json

# WORKFLOW_INPUT_USER_CONTEXT=user_context

# WORKFLOW_INPUT_MODE=conversation_mode

# 分析上下文已嵌入 search_meta_json.analysis_instructions，无需单独开始节点变量

# 若只有一个合并变量，可设 WORKFLOW_COMBINED_INPUT=变量名

#

# 结束节点输出变量名（常见 text / answer / result）

# WORKFLOW_RESPONSE_ANSWER=text

#

# @机器人 检索使用的 schedules 任务名

# SEARCH_SCHEDULE_NAME=weekly-hk-events



# 日志轮转（单文件达上限自动切分；启动时清理超过保留天数的旧文件）

# LOG_MAX_MB=2

# LOG_BACKUP_COUNT=5

# LOG_RETENTION_DAYS=30



# Hybrid 检索（@机器人 语义增强；不影响定时推送）

# HYBRID_SEARCH_ENABLED=1

# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HYBRID_RERANK_POOL=50

# HYBRID_VECTOR_WEIGHT=0.65

# HYBRID_FALLBACK_THRESHOLD=0.55

# EMBEDDING_MODEL_CACHE=./data/models

