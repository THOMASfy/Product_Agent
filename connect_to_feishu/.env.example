# 飞书应用凭证（必填）
FEISHU_APP_ID=cli_aa4f1f6694799bb4
FEISHU_APP_SECRET=请填入你的飞书应用 App Secret

# 要连接的 OpenCode 项目根目录（即包含 opencode.json 的仓库根）。
# 默认自动取 C:\Product_Agent，一般无需修改。
# PLM_PROJECT_ROOT=C:\Product_Agent

# supervisor 智能体 id（默认 plm-supervisor）
# PLM_AGENT=plm-supervisor

# 覆盖会话使用的模型（可选，留空则用 agent 文件里的 model）。
# 正常情况下无需设置：agent 文件与 opencode 配置里的 model 会被直接使用。
# 仅在需要临时切换到别的 provider 时打开，例如：
# PLM_PROVIDER=company-internal
# PLM_MODEL=deepseek-v4-free
# PLM_VARIANT=

# 可选：不走共享后台服务，直接连一个已存在的 OpenCode server
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# OPENCODE_TOKEN=

# 长期记忆：每累计 N 轮（1 轮 = 用户 1 条消息）异步摘要进 memory.md，并清空历史缓冲。
# 关闭：MEMORY_ENABLED=false
# MEMORY_ENABLED=true
# MEMORY_SUMMARY_TURNS=50
# SUMMARY_MODEL=deepseek-v4-free
# 每轮注入提示词的长期记忆最大字符数
# MEMORY_MAX_INJECT_CHARS=6000

# 等待 supervisor 单轮回复的超时（毫秒，默认 1200000 = 20 分钟）
# 文件生成等重任务可调大；正常生成应在 1~2 分钟内完成。
# REPLY_TIMEOUT_MS=1200000

# 管理员判定：在这些 open_id / 部门里的用户记为“管理员”，其余为“普通用户”
ADMIN_OPEN_IDS=
ADMIN_DEPARTMENTS=

# 群里是否只在 @机器人 时才响应（默认 true）
GROUP_MENTION_ONLY=true

# 附件解析后送入 supervisor 的最大字符数（默认 60000）
# MAX_ATTACHMENT_CHARS=60000

# 多模态（图像/扫描件 OCR）走 OpenAI 兼容网关，默认与 opencode.jsonc 里的 provider 一致
# LLM_BASE_URL=http://10.0.62.177:4000/v1
# LLM_API_KEY=sk-填入你的网关密钥
# VISION_MODEL=deepseek-v4
# MAX_VISION_PDF_PAGES=8
# SCANNED_PDF_THRESHOLD=80

# 文件生成依赖（PPT/Word/Excel/PDF）—— 全部装在**服务器**上，用户端零安装。
# 安装脚本见 connect_to_feishu/deploy/。LibreOffice 路径可显式指定：
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# OFFICE_ENABLED=true
# Python 解释器：留空则自动探测 PATH 与常见安装位置（也可显式指定）
# PYTHON_PATH=C:\Users\<user>\AppData\Local\Programs\Python\Python312\python.exe

# 允许回发到飞书的文件目录白名单（agent 回复里用 [[send-file: 路径]] 触发）。
# 留空 = 默认白名单（仓库根、data/user、系统临时目录）
# OUTBOUND_FILE_ROOTS=

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
